Thing http:url:robot1 "Robot Vacuum 1" [ baseURL="http://localhost:3000", refresh=2 ] {
  Channels:
    Type string : status "Status" [ stateExtension="/api/robots/r1/status", stateTransformation="JSONPATH:$.status" ]
    Type number : battery "Battery" [ stateExtension="/api/robots/r1/status", stateTransformation="JSONPATH:$.battery" ]
    Type string : currentTask "Current task" [ stateExtension="/api/robots/r1/status", stateTransformation="JSONPATH:$.currentTask" ]
}


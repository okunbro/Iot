sitemap vacuums label="Vacuum Gateway"
{
  Frame label="Robot 1" {
    Text item=Robot1Status icon="robot"
    Text item=Robot1Battery icon="battery"
    Text item=Robot1CurrentTask icon="text"
  }

  Frame label="Robot 2" {
    Text item=Robot2Status icon="robot"
    Text item=Robot2Battery icon="battery"
    Text item=Robot2CurrentTask icon="text"
  }

  Frame label="Robot 3" {
    Text item=Robot3Status icon="robot"
    Text item=Robot3Battery icon="battery"
    Text item=Robot3CurrentTask icon="text"
  }
  Frame label="Gateway" {
    Text item=GatewayLastAction icon="network"
    Text item=GatewayError icon="error"
  }
}
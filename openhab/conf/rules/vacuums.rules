rule "Robot1 create task"
when
    Item Robot1TaskCreate received command
then
    val payload = receivedCommand.toString.trim

    if(payload == "" || !payload.contains("\"title\"")) {
        GatewayError.postUpdate("ERROR CREATE r1: invalid payload")
        logWarn("vacuums", "Robot1 create task: invalid payload {}", payload)
        return
    }

    var Boolean success = false
    var Number waitMs = 500

    for(var i = 1; i <= 3 && !success; i++) {
        try {
            sendHttpPostRequest(
                "http://localhost:3000/api/robots/r1/tasks",
                "application/json",
                payload,
                3000
            )
            success = true
        } catch(Throwable t) {
            logWarn("vacuums", "Robot1 create attempt {} failed: {}", i.toString, t.toString)
            if(i < 3) {
                Thread::sleep(waitMs.intValue)
                waitMs = waitMs * 2
            }
        }
    }

    if(success) {
        GatewayError.postUpdate("OK")
        GatewayLastAction.postUpdate("CREATE r1: " + payload)
        logInfo("vacuums", "Robot1 create success")
    } else {
        GatewayError.postUpdate("ERROR CREATE r1: request failed")
    }
end


rule "Robot1 update task"
when
    Item Robot1TaskUpdate received command
then
    val payload = receivedCommand.toString.trim

    if(payload == "" || !payload.contains("\"id\"")) {
        GatewayError.postUpdate("ERROR UPDATE r1: invalid payload")
        logWarn("vacuums", "Robot1 update task: invalid payload {}", payload)
        return
    }

    val matcher = java.util.regex.Pattern.compile("\"id\"\\s*:\\s*(\\d+)").matcher(payload)

    if(!matcher.find) {
        GatewayError.postUpdate("ERROR UPDATE r1: task id not found")
        logWarn("vacuums", "Robot1 update task: task id not found in payload {}", payload)
        return
    }

    val taskId = matcher.group(1)

    var Boolean success = false
    var Number waitMs = 500

    for(var i = 1; i <= 3 && !success; i++) {
        try {
            sendHttpPutRequest(
                "http://localhost:3000/api/robots/r1/tasks/" + taskId,
                "application/json",
                payload,
                3000
            )
            success = true
        } catch(Throwable t) {
            logWarn("vacuums", "Robot1 update attempt {} failed: {}", i.toString, t.toString)
            if(i < 3) {
                Thread::sleep(waitMs.intValue)
                waitMs = waitMs * 2
            }
        }
    }

    if(success) {
        GatewayError.postUpdate("OK")
        GatewayLastAction.postUpdate("UPDATE r1 task " + taskId)
        logInfo("vacuums", "Robot1 update success")
    } else {
        GatewayError.postUpdate("ERROR UPDATE r1: request failed")
    }
end


